<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%c{1}] %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.apache.kyuubi.engine.dataagent.agent" level="INFO"/>
        <Logger name="com.openai" level="WARN"/>
        <Logger name="okhttp3" level="WARN"/>
        <Root level="WARN">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
